{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "genohack",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "pr3-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d ..\\genohack-pr3 && npx vite --port 8443 --strictPort"],
      "port": 8443
    },
    {
      "name": "pr3-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d ..\\genohack-pr3 && ..\\genohack\\.venv\\Scripts\\python.exe -m uvicorn backend.api:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    }
  ]
}
